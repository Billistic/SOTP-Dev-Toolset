# SQLAlchemy URL; relative SQLite paths resolve from the directory uvicorn runs in.
DATABASE_URL=sqlite:///./sotp_devenv.db

# Optional: seeds a project on first start if the database has none.
SOTP_MOD_ROOT=C:/Users/USER2/Documents/Projects/SOTP/sotp-rebuild-master/sotp-rebuild-master

# Optional: base-game install, used as a fallback when resolving references
# (vanilla brushes, particles, sounds, meshes the mod inherits).
# SINS_VANILLA_ROOT=C:/Program Files (x86)/Steam/steamapps/common/Sins of a Solar Empire Rebellion

CORS_ORIGINS=http://localhost:5173
HOST=127.0.0.1
PORT=8000
